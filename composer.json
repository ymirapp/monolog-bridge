{
    "name": "ymirapp/monolog-bridge",
    "description": "Monolog integration for Ymir",
    "license": "MIT",
    "authors": [
        {
            "name": "Carl Alexander",
            "email": "support@ymirapp.com",
            "homepage": "https://ymirapp.com"
        }
    ],
    "require": {
        "php": ">=7.2.5",
        "monolog/monolog": "^2.0|^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpunit/phpunit": "^8.0",
        "rector/rector": "^2.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Ymir\\Bridge\\Monolog\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ymir\\Bridge\\Monolog\\Tests\\": "tests"
        }
    },
    "prefer-stable": true,
    "scripts": {
        "php-cs-fixer": "php-cs-fixer fix --dry-run --allow-risky=yes",
        "php-cs-fixer:fix": "php-cs-fixer fix --allow-risky=yes",
        "rector": "rector --dry-run",
        "rector:fix": "rector",
        "tests:unit": "phpunit --testsuite unit"
    }
}
